# Copy to .env and fill in real values. .env itself is gitignored.
#
# In production (Railway), set every var below in the service
# Variables panel. Anything missing here that the app needs at
# runtime → 500 / startup crash.

# ─── Service identity ─────────────────────────────────────────
# Use `production` on Railway; toggles logging defaults and lets
# us branch on environment if we add prod-only behavior later.
ENVIRONMENT=development

# ─── HTTP ─────────────────────────────────────────────────────
# Comma-separated origins. Leave empty in production — rag-service
# is NEVER called from a browser; only Level-2 / Level-3 backends
# talk to it. Setting origins here would be an attack surface widener.
CORS_ORIGINS=

# ─── Database (Neon PostgreSQL) ───────────────────────────────
# Copy the connection string from the Neon Dashboard:
#   Role:     rag_service_user
#   Database: gatewaydb
# Paste it as-is (libpq format). Our code rewrites the prefix to
# `postgresql+asyncpg://` and strips the `?sslmode=...` query —
# asyncpg uses the `ssl=` kwarg, not the libpq query param.
# Pool sizing tuned for Neon free tier; raise in production.
DATABASE_URL=postgresql://rag_service_user:PASSWORD@HOST.eu-central-1.aws.neon.tech/gatewaydb?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# ─── OpenAI (embeddings) ──────────────────────────────────────
# Required: rag-service refuses to embed without it. Use the same
# key as Level-2 backend (or split into separate billable keys per
# service if you want per-service usage dashboards in OpenAI).
OPENAI_API_KEY=sk-...
# Pinned model + dimension. Changing either later requires a DB
# migration (new vector column) and a re-embed of all chunks.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# ─── Storage (uploaded originals) ─────────────────────────────
# `local` writes to STORAGE_LOCAL_PATH inside the container.
# On Railway WITHOUT a volume mount this path is ephemeral:
# chunks/vectors live in Postgres so search & chat keep working,
# but "download original" links 404 after a redeploy. Mount a
# Railway volume at /app/storage to make originals persistent.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# ─── Internal service-to-service auth (HS256 JWT) ─────────────
# Shared secret between rag-service (verifies) and the consuming
# app backends (mint short-lived tokens). MUST match the writer
# backend's RAG_INTERNAL_JWT_SECRET exactly, byte-for-byte, or
# every call gets 401. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_JWT_SECRET=replace-with-32-byte-urlsafe-secret
INTERNAL_JWT_ALGORITHM=HS256

