# Widget dev demo config (Vite reads VITE_* at build/serve time).
# The demo host page (index.html) uses these to mount the widget against
# your local backend. bot_id + tenant_id must be REAL UUIDs from your
# Level-3 dev DB (create a bot via the admin API, then copy its ids).
VITE_API_BASE=http://localhost:8200
VITE_BOT_ID=
VITE_TENANT_ID=
