# ─── Service identity ───────────────────────────────────────────
ENVIRONMENT=development
SERVICE_NAME=chatbot-service

# ─── HTTP / CORS ────────────────────────────────────────────────
# The admin panel (Angular) and the embeddable widget call this API
# from the browser, so their origins must be allow-listed here.
# Comma-separated, or a JSON array, or empty.
# Example (dev): http://localhost:5173,http://localhost:4202
# Example (prod): https://admin.oursaas.com,https://the-tenant-site.com
CORS_ORIGINS=

# ─── Database (Level-3 OWN Neon PostgreSQL) ─────────────────────
# SEPARATE database from gatewaydb and rag-service. Create a new Neon
# project (EU region: Frankfurt) and paste its connection string here.
# Format: postgresql://user:pwd@host/dbname?sslmode=require
DATABASE_URL=

# ─── OpenAI (embeddings + chat) ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── Storage (uploaded files) ───────────────────────────────────
# Local FS backend for MVP. Cloud backends (Cloudflare R2, Hetzner
# Object Storage) plug in later via storage.py without touching callers.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# ─── Auth (JWT) ─────────────────────────────────────────────────
# HMAC secret for signing/verifying all app-issued tokens (tenant/admin
# JWT, anonymous widget session JWT, preview token). Scope is carried in
# the token's `scope` claim. Generate 32+ random bytes with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# Token lifetimes (seconds).
ADMIN_TOKEN_TTL=3600
WIDGET_TOKEN_TTL=86400
PREVIEW_TOKEN_TTL=300

# ─── Rate limiting (M8) ─ technical abuse prevention ──────────────
# Per-client (IP) request caps (slowapi "<count>/<period>" syntax). NOT
# plan-based quota — that is a future billing feature. In-memory storage;
# point slowapi at Redis once the backend runs more than one instance.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_WIDGET_SESSION=10/minute
RATE_LIMIT_WIDGET_CHAT=30/minute

# ─── Content moderation (M8) ─ input screening ────────────────────
# Screen each user message with OpenAI's free omni-moderation-latest model
# before retrieval/LLM. Flagged turns get a canned refusal (no model call).
# Fails open on provider error so a moderation outage never breaks chat.
MODERATION_ENABLED=true
# MODERATION_REFUSAL_MESSAGE="I can't help with that request. Please rephrase it or ask something else."
